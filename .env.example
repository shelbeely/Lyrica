# Lyrica API example env file
GENIUS_TOKEN=
YOUTUBE_COOKIE=  # if you use YTMusic auth requiring headers/cookies
CACHE_DIR=cache
CACHE_TTL=3600
LOG_LEVEL=INFO

# Optional: Musixmatch API key (free tier at https://developer.musixmatch.com/)
# Enables fetcher ID 7 (100+ language lyrics database).  Leave blank to skip.
MUSIXMATCH_TOKEN=
